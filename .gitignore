# Unity default gitignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Asset meta files must be kept, even if matching above
/[Ll]ibrary/**/*
/[Tt]emp/**/*
/[Oo]bj/**/*
/[Bb]uild/**/*
/[Bb]uilds/**/*
/[Ll]ogs/**/*
/[Uu]serSettings/**/*
/[Mm]emoryCaptures/**/*

# Generated properties and settings files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
